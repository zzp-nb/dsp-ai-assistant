# Streamlit Community Cloud -> App settings -> Secrets
# 直接粘贴 TOML，不要加 Markdown 代码块。
# 这些值只在服务端可用，Streamlit 不会把它们发给浏览器。

DSP_CLASS_PASSWORD = ""
DSP_TEACHER_PASSWORD = ""
DEEPSEEK_API_KEY = ""

DEEPSEEK_MODEL = "deepseek-chat"
DEEPSEEK_BASE_URL = "https://api.deepseek.com"

# true = 完全离线（推荐给不想使用 API 的课程）；false = 有 Key 时在线调用。
DSP_OFFLINE_MODE = true

DSP_DAILY_STUDENT_LIMIT = 30
DSP_DAILY_GLOBAL_LIMIT = 300
DSP_MAX_INPUT_CHARS = 1200
DSP_MAX_OUTPUT_TOKENS = 2400

# 可选：持久化目录。Streamlit Community Cloud 没有持久卷；
# 只有在挂载了持久磁盘的服务器/Docker 上才有意义。
# DSP_DATA_DIR = "/var/data/dsp"
